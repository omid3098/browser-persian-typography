{
  "manifest_version": 3,
  "name": "Persian Typography",
  "version": "0.1.0",
  "description": "Persian letters in Vazirmatn, with a direction for each text block.",
  "permissions": ["storage", "fontSettings"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Persian Typography",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/on.png", "32": "icons/on.png" }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["direction.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "web_accessible_resources": [{
    "resources": ["fonts/Vazirmatn.woff2"],
    "matches": ["<all_urls>"]
  }]
}
