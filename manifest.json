{
  "manifest_version": 3,
  "name": "Persian Typography",
  "version": "0.1.0",
  "description": "Persian text in the Vazirmatn font, with the right direction for each text block, on any site. One switch for each site.",
  "permissions": ["storage", "fontSettings", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/toolbar-on-16.png", "32": "icons/toolbar-on-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Persian Typography",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/toolbar-on-16.png", "32": "icons/toolbar-on-32.png" }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["shadow-roots.js"],
    "world": "MAIN",
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }, {
    "matches": ["<all_urls>"],
    "js": ["direction.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "web_accessible_resources": [{
    "resources": ["fonts/Vazirmatn.woff2"],
    "matches": ["<all_urls>"]
  }]
}
